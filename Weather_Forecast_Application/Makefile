####### Compile

main.o: main.cpp Includes/Cities.h \
		GUI/mainWindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

Cities.o: Sources/Cities.cpp Includes/Cities.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Cities.o Sources/Cities.cpp

DataAbstract.o: Sources/DataAbstract.cpp Includes/DataAbstract.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o DataAbstract.o Sources/DataAbstract.cpp

Data.o: Sources/Data.cpp Includes/Data.h \
		Includes/DataAbstract.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Data.o Sources/Data.cpp

CurlAbstract.o: Sources/CurlAbstract.cpp Includes/CurlAbstract.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o CurlAbstract.o Sources/CurlAbstract.cpp

Curl.o: Sources/Curl.cpp Includes/Curl.h \
		Includes/CurlAbstract.h \
		Includes/DataAbstract.h \
		Includes/Data.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Curl.o Sources/Curl.cpp

RapidjsonAbstract.o: Sources/RapidjsonAbstract.cpp Includes/RapidjsonAbstract.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o RapidjsonAbstract.o Sources/RapidjsonAbstract.cpp

Rapidjson.o: Sources/Rapidjson.cpp Includes/Rapidjson.h \
		Includes/RapidjsonAbstract.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Rapidjson.o Sources/Rapidjson.cpp

mainWindow.o: GUI/mainWindow.cpp GUI/mainWindow.h \
		Includes/Cities.h \
		Includes/Data.h \
		Includes/DataAbstract.h \
		Includes/Curl.h \
		Includes/CurlAbstract.h \
		Includes/Rapidjson.h \
		Includes/RapidjsonAbstract.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainWindow.o GUI/mainWindow.cpp

moc_mainWindow.o: moc_mainWindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainWindow.o moc_mainWindow.cpp

